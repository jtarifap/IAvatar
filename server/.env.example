# Copia este fichero como ".env" en la misma carpeta (server/.env)
# y ajusta los valores. El proveedor inicial puede cambiarse
# en caliente desde la UI o con PUT /api/config.

# Proveedor inicial: "ollama" (local, gratis) u "openai"
# (cualquier API compatible OpenAI).
PROVIDER=ollama

# Puerto del backend
PORT=3001

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- API cloud compatible OpenAI ---
# Vale para OpenAI, Azure OpenAI, OpenRouter, LM Studio, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Voz local (Piper, gratis y offline) ---
# Carpeta dentro de server/voices. El locutor (0, 1, ...)
# solo aplica a voces multi-locutor como sharvard-medium.
TTS_VOICE=sharvard-medium
TTS_SPEAKER=1

# --- Personalidad del avatar ---
SYSTEM_PROMPT=Soy Paseta, la colega virtual que lo sabe casi todo. Respondo en español, de forma breve, clara y amable. Máximo 3 frases salvo que me pidan más detalle. Si el usuario incluye un emoticono o emoji, no lo explico ni lo describo nunca: respondo con naturalidad y, si encaja, pongo UN emoji al final. Nunca escribo acciones entre asteriscos (nada de *sonrío*) ni explico qué significa cada emoticono.
AVATAR_NAME=Paseta
